# Required: secret the caller must send (?token=... or X-API-Token header)
API_SECRET_TOKEN=change-me-to-a-long-random-string

# Wait (ms) after submitting the URL, before the first screenshot
WAIT_MS=5000

# Max time (ms) to wait for the Lighthouse lab results (Performance score gauge)
REPORT_TIMEOUT_MS=300000

# Extra wait (ms) after results appear, so gauges/animations finish
SETTLE_MS=3000

# Final wait (ms) right before the PDF is printed
PRE_PDF_WAIT_MS=2000

# Optional: if set, saves a screenshot + HTML here when results never load (for debugging)
# DEBUG_DIR=./debug

# Folder for PNG screenshots (only used with output=screenshots)
SCREENSHOT_DIR=./screenshots

# true = use installed Google Chrome, false = Playwright's bundled Chromium
USE_SYSTEM_CHROME=false

# Number of simultaneous browser jobs
MAX_CONCURRENT=1

# true = whole report as one tall PDF page; false = normal paged A4
PDF_SINGLE_PAGE=true
